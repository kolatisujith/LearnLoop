<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${empty pageTitle ? 'LearnLoop' : pageTitle}"/></title>
    <meta name="description" content="LearnLoop is an invitation-only learning platform for administrators, teachers and students.">
    <link rel="icon" href="${ctx}/assets/images/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="${ctx}/webjars/bootstrap/5.3.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="${ctx}/assets/css/style.css">

</head>
<body class="ll-body">
<a class="ll-skip-link" href="#main-content">Skip to main content</a>

<nav class="navbar navbar-expand-lg ll-navbar" aria-label="Primary navigation">
    <div class="container">
        <a class="navbar-brand ll-brand" href="${ctx}/">
            <span class="ll-brand-mark" aria-hidden="true">
                <svg viewBox="0 0 32 32" width="22" height="22" fill="none">
                    <path d="M11 21.5a6.4 6.4 0 0 1 0-9.1l3-3a6.4 6.4 0 0 1 9.1 9.1l-1.7 1.7"
                          stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
                    <path d="M21 10.5a6.4 6.4 0 0 1 0 9.1l-3 3a6.4 6.4 0 0 1-9.1-9.1l1.7-1.7"
                          stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
                </svg>
            </span>
            <span>LearnLoop</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#llNavbar"
                aria-controls="llNavbar" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="llNavbar">
            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                <li class="nav-item">
                    <a class="nav-link" href="${ctx}/#features">Features</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="${ctx}/#how-it-works">How it works</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="${ctx}/#roles">Roles</a>
                </li>
                <c:if test="${not empty sessionScope.authUser}">
                    <li class="nav-item">
                        <c:choose>
                            <c:when test="${sessionScope.authUser.role == 'ADMIN'}">
                                <a class="nav-link" href="${ctx}/admin/dashboard">Dashboard</a>
                            </c:when>
                            <c:when test="${sessionScope.authUser.role == 'TEACHER'}">
                                <a class="nav-link" href="${ctx}/teacher/dashboard">Dashboard</a>
                            </c:when>
                            <c:otherwise>
                                <a class="nav-link" href="${ctx}/student/dashboard">Dashboard</a>
                            </c:otherwise>
                        </c:choose>
                    </li>
                </c:if>
                <li class="nav-item">
                    <a class="nav-link ll-status-link" id="platform-status" href="${ctx}/health"
                       data-health-url="${ctx}/health" aria-live="polite">
                        <span class="ll-status-dot" aria-hidden="true"></span>
                        <span data-status-text>Checking status</span>
                    </a>
                </li>
            </ul>
            <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2 ms-lg-3 mt-3 mt-lg-0">
                <c:choose>
                    <c:when test="${not empty sessionScope.authUser}">
                        <span class="ll-nav-user">
                            <span class="ll-nav-user-role"><c:out value="${sessionScope.authUser.role}"/></span>
                            <c:out value="${sessionScope.authUser.fullName}"/>
                        </span>
                        <form method="post" action="${ctx}/logout" class="ll-nav-logout-form">
                            <input type="hidden" name="_csrf" value="<c:out value='${sessionScope.csrfToken}'/>">
                            <button type="submit" class="btn ll-btn-outline">Log out</button>
                        </form>
                    </c:when>
                    <c:otherwise>
                        <a class="btn ll-btn-outline" href="${ctx}/login">Log in</a>
                        <a class="btn ll-btn-primary" href="${ctx}/register">Get started</a>
                    </c:otherwise>
                </c:choose>
            </div>
        </div>
    </div>
</nav>
